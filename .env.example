# Development: leave DATABASE_URL empty to use SQLite.
DATABASE_URL=

# Production: PostgreSQL/Supabase connection string.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Email password reset (SMTP). For Gmail, use a Google App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM=your_email@gmail.com
APP_URL=https://your-app-name.streamlit.app

# Optional SQLite path
SQLITE_PATH=data/expenses.db
